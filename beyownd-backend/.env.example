# Copy to .env and fill in. Never commit .env.

# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000
# Number of proxies in front of the API (0 locally, 1 behind Nginx)
TRUST_PROXY=0
# trace | debug | info | warn | error
LOG_LEVEL=debug

# ---- Database ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/beyownd
MONGO_MAX_POOL_SIZE=20

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Beyownd <noreply@beyownd.in>

# ---- Google Sign-In ----
GOOGLE_CLIENT_ID=

# ---- Razorpay (Dashboard → Account & Settings → API Keys; test mode = rzp_test_...) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Your own random string; paste the same value in Razorpay → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ---- Documents: issuer (legal entity) printed on letters/certificates ----
# Beyownd is a product of GrewDo - docs/business-model.md §7. Placeholders print until set.
ISSUER_LEGAL_NAME=GrewDo
ISSUER_REGISTRATION_NO=
ISSUER_ADDRESS=
ISSUER_EMAIL=hello@beyownd.in
ISSUER_SIGNATORY_NAME=
ISSUER_SIGNATORY_TITLE=Founder
# Printed in the PDF + QR code
VERIFY_BASE_URL=https://beyownd.in/verify

# ---- Document storage (dev: local folder; production: Cloudflare R2 in Phase 6) ----
# STORAGE_LOCAL_DIR=.tmp/documents
# Base URL used in signed download links
API_PUBLIC_URL=http://localhost:5000

# Lesson images + widgets (content-addressed). Defaults: .tmp/assets and
# <API_PUBLIC_URL>/api/assets. Phase 6: point ASSET_PUBLIC_URL at the R2 CDN.
# ASSET_LOCAL_DIR=.tmp/assets
# ASSET_PUBLIC_URL=https://assets.beyownd.in
